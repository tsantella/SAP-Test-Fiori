<mvc:View controllerName="project1.controller.MyCycles"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page id="MyCycles" title="{i18n>MyCycles}">
        <content>
            <VBox id="_IDGenVBox1">
                <!-- Action Buttons -->
                <HBox id="_IDGenHBox">
                    <Button id="btnSearch" text="{i18n>search}" press="onSearch" />
                    <Button id="btnNew" text="{i18n>new}" press="onNew" />
                    <Button id="btnDelete" text="{i18n>delete}" press="onDelete" />
                    <Button id="btnView" text="{i18n>view}" press="onView" />
                    <Button id="btnStopCycle" text="{i18n>stopCycle}" press="onStopCycle" />
                </HBox>

                <!-- Table -->
                <Table id="tblCycles" inset="false">
                    <headerToolbar>
                        <Toolbar id="_IDGenToolbar">
                            <Title id="_IDGenTitle" text="{i18n>myCycle}" />
                        </Toolbar>
                    </headerToolbar>
                    <columns>
                        <Column id="_IDGenColumn">
                            <Text id="_IDGenText" text="{i18n>creator}" />
                        </Column>
                        <Column id="_IDGenColumn1">
                            <Text id="_IDGenText1" text="{i18n>title}" />
                        </Column>
                        <Column id="_IDGenColumn2">
                            <Text id="_IDGenText2" text="{i18n>cycleStatus}" />
                        </Column>
                        <Column id="_IDGenColumn3">
                            <Text id="_IDGenText3" text="{i18n>uploadStatus}" />
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem id="_IDGenColumnListItem">
                            <cells>
                                <Text id="_IDGenText4" text="{Creator}" />
                                <Text id="_IDGenText5" text="{Title}" />
                                <Text id="_IDGenText6" text="{CycleStatus}" />
                                <Text id="_IDGenText7" text="{UploadStatus}" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </content>
    </Page>
</mvc:View>
