<mvc:View controllerName="project1.controller.MyCycles"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page id="MyCycles" showHeader="false" class="myCyclesPage">
        <content>
            <VBox id="_IDGenVBox1">

                <!-- Custom title header -->
                <HBox id="titleHeaderBox" class="myCycleHeaderWrapper" alignItems="Center">
                    <FlexBox id="titleBadge" class="myCycleBadge" alignItems="Center" justifyContent="Center">
                        <Text id="titleBadgeText" text="{i18n>MyCycles}" class="myCycleBadgeText"/>
                    </FlexBox>
                </HBox>
            
                <!-- Action Buttons -->
                <Toolbar id="tbHeader" class="sapUiSmallMarginBottom">
                <!-- Left side buttons -->
                <Button id="btnSearch"
                        text="{i18n>search}"
                        icon="sap-icon://search"
                        press="onSearch"
                        class="pillButton pillButtonGrey"/>
                <Button id="btnNew"
                        text="{i18n>new}"
                        icon="sap-icon://document-text"
                        press="onNew"
                        class="pillButton pillButtonGrey sapUiTinyMarginBegin"/>
                <Button id="btnDelete"
                        text="{i18n>delete}"
                        icon="sap-icon://delete"
                        press="onDelete"
                        enabled="false"
                        class="pillButton pillButtonGrey sapUiTinyMarginBegin"/>
                <Button id="btnView"
                        text="{i18n>view}"
                        icon="sap-icon://show"
                        press="onView"
                        enabled="false"
                        class="pillButton pillButtonGrey sapUiTinyMarginBegin"/>
                <Button id="btnStopCycle"
                        text="{i18n>stopCycle}"
                        icon="sap-icon://stop"
                        press="onStopCycle"
                        enabled="false"
                        type="Reject"
                        class="pillButton sapUiTinyMarginBegin"/>

                <!-- Push everything after this to the right -->
                <ToolbarSpacer id="_IDGenToolbarSpacer"/>

                    <!-- Pagination -->
                    <Button
                        id="btnFirstPage"
                        icon="sap-icon://media-rewind"
                        type="Transparent"
                        press="onFirstPage"
                        enabled="false"
                        tooltip="First Page"/>

                    <Button
                        id="btnPreviousPage"
                        icon="sap-icon://slim-arrow-left"
                        type="Transparent"
                        press="onPreviousPage"
                        enabled="false"
                        tooltip="Previous Page"/>

                    <Text
                        id="txtPaginationInfo"
                        text="0 to 0 of 0"
                        class="sapUiTinyMarginBeginEnd"/>

                    <Button
                        id="btnNextPage"
                        icon="sap-icon://slim-arrow-right"
                        type="Transparent"
                        press="onNextPage"
                        enabled="false"
                        tooltip="Next Page"/>

                    <Button
                        id="btnLastPage"
                        icon="sap-icon://media-forward"
                        type="Transparent"
                        press="onLastPage"
                        enabled="false"
                        tooltip="Last Page"/>
                </Toolbar>

                <!-- Table -->
                <Table id="tblCycles"
                       inset="false"
                       items="{cycles>/Cycles}">
                    <columns>
                        <Column id="_IDGenColumn2"><Text id="_IDGenText1" text="Creator" /></Column>
                        <Column id="_IDGenColumn3"><Text id="_IDGenText2" text="Title" /></Column>
                        <Column id="_IDGenColumn4"><Text id="_IDGenText3" text="Cycle Status" /></Column>
                        <Column id="_IDGenColumn5"><Text id="_IDGenText4" text="Upload Status" /></Column>
                    </columns>
                    <items>
                        <ColumnListItem id="_IDGenColumnListItem" type="Active" press="onRowPress">
                            <cells>
                                <Text id="_IDGenText5" text="{cycles>Creator}" />
                                <Text id="_IDGenText6" text="{cycles>Title}" />
                                <Text id="_IDGenText7" text="{cycles>CycleStatus}" />
                                <Text id="_IDGenText8" text="{cycles>UploadStatus}" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </content>
    </Page>
</mvc:View>